<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.piotr-janczukowicz</groupId>
    <artifactId>common-parent</artifactId>
    <version>16</version>
    <relativePath/>
  </parent>

  <artifactId>gitlab-sdk</artifactId>
  <version>19.6.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>gitlab-sdk</name>
  <description>Object layer over gitlab-rest-client: models that carry methods calling the GitLab REST API</description>
  <url>https://github.com/piotr-janczukowicz/gitlab-sdk</url>

  <properties>
    <gitlab-api-internal.version>19.6.0-SNAPSHOT</gitlab-api-internal.version>
    <common-core.version>8</common-core.version>
    <skipITs>true</skipITs>
  </properties>

  <dependencies>
    <dependency>
      <groupId>io.github.piotr-janczukowicz</groupId>
      <artifactId>gitlab-api-internal</artifactId>
      <version>${gitlab-api-internal.version}</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>io.github.piotr-janczukowicz</groupId>
      <artifactId>common-core</artifactId>
      <version>${common-core.version}</version>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <groups>unit</groups>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>smoke</id>
      <properties>
        <jacoco.skip>true</jacoco.skip>
        <skipITs>false</skipITs>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-failsafe-plugin</artifactId>
            <configuration>
              <groups combine.self="override">smoke</groups>
              <includes combine.children="override">
                <include>**/smoke/*SmokeIT.java</include>
              </includes>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
